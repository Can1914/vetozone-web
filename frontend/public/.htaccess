# SMTP credentials. The file belongs above the web root; this is the backstop
# for when it has to sit next to contact.php instead.
<FilesMatch "^(mail-config|mail-config\.example)\.php$">
  Require all denied
</FilesMatch>

# PHPMailer's sources are only ever included by contact.php, never requested.
RedirectMatch 404 ^/lib/PHPMailer/.*$

# React Router uses real URLs (/cihazlar, /tedavi-alanlari/dermatoloji ...).
# Apache would look for matching folders on disk and return 404 on a direct
# visit or refresh, so anything that is not an existing file or directory is
# served index.html and routed client-side instead.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
